    {
      "id": "102",
      "name": "泡泡命名",
      "age": "6-24月",
      "ageRange": {
        "min": 6,
        "max": 24
      },
      "ability": "语言沟通",
      "duration": "5分钟",
      "place": "浴室",
      "materials": "沐浴露、水",
      "people": "1对1",
      "play": "搓出泡泡，一边玩一边说“泡泡、大大的、破了”。",
      "steps": [
        "手上搓出泡泡，举到宝宝面前。",
        "吹一下，说“泡泡飞了”。",
        "让他伸手拍，说“破了”。",
        "把泡泡放在他手背上，说“泡泡在手上”。"
      ],
      "observe": [
        "会伸手抓泡泡",
        "会模仿“泡泡”的音",
        "听到“破了”会笑。"
      ],
      "up": "说出“大泡泡、小泡泡”。",
      "down": "只吹不碰。",
      "safety": "用无泪配方，泡泡不入口、不进眼，地面防滑。",
      "question": "宝宝吃泡泡怎么办？少量无泪配方不危险，但要及时用清水冲掉，别让他一直舔。",
