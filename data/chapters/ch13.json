    {
      "id": "105",
      "name": "袜子找朋友",
      "age": "18-36月",
      "ageRange": {
        "min": 18,
        "max": 36
      },
      "ability": "认知探索",
      "duration": "5分钟",
      "place": "床/地垫",
      "materials": "袜子",
      "people": "1对1",
      "play": "洗完衣服后，把袜子配成一对。",
      "steps": [
        "摊开4-5双袜子。",
        "拿起一只问“它的朋友在哪”。",
        "让他找出相同的一只，卷成球。",
        "一起投进抽屉的“袜子篮”。"
      ],
      "observe": [
        "能按颜色或图案配对",
        "会主动寻找",
        "能说出“一样”。"
      ],
      "up": "按颜色分组。",
      "down": "只用两双。",
      "safety": "袜子不套手奔跑，抽屉不夹手。",
      "question": "配错要不要纠正？先问“为什么觉得是一对”，再一起看花纹，保护他的判断欲。",
