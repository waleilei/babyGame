    {
      "id": "103",
      "name": "浴巾躲猫猫",
      "age": "6-18月",
      "ageRange": {
        "min": 6,
        "max": 18
      },
      "ability": "社会情绪",
      "duration": "3分钟",
      "place": "浴室/床",
      "materials": "大浴巾",
      "people": "1对1",
      "play": "用浴巾把宝宝裹起来，再“变”出来。",
      "steps": [
        "洗完用浴巾裹住身体，露出脸。",
        "说“宝宝不见了”，停2秒。",
        "轻轻拉开一角说“在这里”。",
        "裹着浴巾抱到床上，继续玩一次。"
      ],
      "observe": [
        "会笑、会自己拉浴巾",
        "会预期“出现”的时刻",
        "主动躲。"
      ],
      "up": "让他自己盖住自己。",
      "down": "只裹不遮脸。",
      "safety": "不盖住口鼻，浴巾不裹太紧，浴室地面先擦干。",
      "question": "玩兴奋了不肯睡怎么办？睡前的躲猫猫要“低强度”，动作慢、声音轻，玩两次就收。",
