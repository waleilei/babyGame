    {
      "id": "104",
      "name": "穿衣顺序歌",
      "age": "12-24月",
      "ageRange": {
        "min": 12,
        "max": 24
      },
      "ability": "生活自理",
      "duration": "3分钟",
      "place": "卧室",
      "materials": "衣服",
      "people": "1对1",
      "play": "把穿衣编成固定顺序歌，边唱边穿。",
      "steps": [
        "固定四句：“先穿头，再穿手，拉一拉，扣一扣”。",
        "每穿一件唱一遍。",
        "让他自己伸手进袖子。",
        "穿完一起照镜子说“穿好了”。"
      ],
      "observe": [
        "会主动伸手",
        "听到歌会配合抬脚",
        "能预期下一步。"
      ],
      "up": "让他自己选今天穿哪件。",
      "down": "只唱歌不要求配合。",
      "safety": "不用带长绳的帽子，纽扣缝牢，不穿过多衣物。",
      "question": "每天早上像打仗？把“选择权”给他（红袜子还是蓝袜子），配合度会明显上升。",
      "art": {
        "main": "assets/ill/104.svg",
