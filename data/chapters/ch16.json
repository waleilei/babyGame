          "assets/art/panel_web/120-2.jpg",
          "assets/art/panel_web/120-3.jpg",
          "assets/art/panel_web/120-4.jpg"
        ]
      }
    },
    {
      "id": "121",
      "name": "红绿灯木头人",
      "age": "24-36月",
      "ageRange": {
        "min": 24,
        "max": 36
      },
      "ability": "大运动",
      "duration": "10分钟",
      "place": "户外",
      "materials": "无",
      "people": "2人以上",
      "play": "你说“绿灯”就走，“红灯”就定住不动。",
      "steps": [
        "先原地练习“走—停”。",
        "你喊“绿灯”，一起走。",
        "喊“红灯”，定住3秒。",
        "加入“黄灯”慢慢走。"
      ],
      "observe": [
        "能听到指令停住",
        "能保持3-5秒",
        "会自己喊口令。"
      ],
      "up": "加入“单脚站”。",
      "down": "只用“停”。",
      "safety": "在封闭场地玩，远离马路，地面平整。",
      "question": "停不住总往前冲？把“停”练成游戏而不是命令，从1秒开始，成功就夸张表扬。",
