          "assets/art/panel_web/121-2.jpg",
          "assets/art/panel_web/121-3.jpg",
          "assets/art/panel_web/121-4.jpg"
        ]
      }
    },
    {
      "id": "122",
      "name": "踩影子",
      "age": "24-36月",
      "ageRange": {
        "min": 24,
        "max": 36
      },
      "ability": "大运动",
      "duration": "10分钟",
      "place": "户外",
      "materials": "阳光",
      "people": "2人以上",
      "play": "追着踩对方的影子，也要保护自己的影子。",
      "steps": [
        "找一块有阳光的空地。",
        "说“我要踩你的影子啦”。",
        "他跑你追，踩到就换他追。",
        "累了就坐下来看影子变长变短。"
      ],
      "observe": [
        "会躲、会追",
        "能理解“影子跟着人”",
        "跑动中能停。"
      ],
      "up": "玩“影子变大变小”。",
      "down": "只踩静止的影子。",
      "safety": "避开正午暴晒，场地无台阶和车辆，穿防滑鞋。",
      "question": "阴天玩不了？改成“踩地砖线”或“踩落叶”，规则一样。",
