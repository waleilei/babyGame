      }
    },
    {
      "id": "120",
      "name": "餐厅等待包",
      "age": "12-36月",
      "ageRange": {
        "min": 12,
        "max": 36
      },
      "ability": "生活自理",
      "duration": "20分钟",
      "place": "餐厅",
      "materials": "小包：贴纸、蜡笔、小书",
      "people": "1对1",
      "play": "出门前准备一个“等待包”，只在餐厅拿出来。",
      "steps": [
        "包里放3样东西：贴纸、蜡笔和纸、一本小书。",
        "点完菜先拿出一件。",
        "每10分钟换一件，不一次全给。",
        "上菜后收包，专心吃饭。"
      ],
      "observe": [
        "能安静玩5-10分钟",
        "会主动要求换一样",
        "等待时不哭闹。"
      ],
      "up": "加入“点菜”任务。",
      "down": "只带贴纸。",
      "safety": "不玩餐具、不喝热饮，座位远离上菜口。",
      "question": "还是要看手机？等待包的效果取决于“只在这个时候出现”，平时收好，保持新鲜感。",
      "art": {
        "main": "assets/art/panel_web/120-1.jpg",
        "panels": [
