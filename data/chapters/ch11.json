    {
      "id": "78",
      "name": "积木造桥",
      "age": "25-30月",
      "ageRange": {
        "min": 25,
        "max": 30
      },
      "ability": "认知探索",
      "duration": "10分钟",
      "place": "地垫",
      "materials": "积木、小球",
      "people": "1对1",
      "play": "搭一座桥，让小球从下面滚过去。",
      "steps": [
        "用两块积木做桥墩，上面横一块长积木。",
        "示范小球从桥下滚过。",
        "让他自己搭，塌了就重来。",
        "成功后加宽桥面，试试能不能过两辆车。"
      ],
      "observe": [
        "会留出桥洞",
        "能调整桥墩距离",
        "塌了会重建。"
      ],
      "up": "搭两层桥。",
      "down": "只用两块积木搭门。",
      "safety": "积木无尖角，不在高处搭，避免砸脚。",
      "question": "总搭不高就急？先练“搭门”这个单一结构，成功感比高度重要。",
