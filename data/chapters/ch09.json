  "games": [
    {
      "id": "49",
      "name": "追球跑",
      "age": "13-18月",
      "ageRange": {
        "min": 13,
        "max": 18
      },
      "ability": "大运动",
      "duration": "10分钟",
      "place": "户外/客厅",
      "materials": "皮球1个",
      "people": "1对1",
      "play": "把球滚出去，让宝宝追着跑回来。",
      "steps": [
        "你先把球慢慢滚出去3-5米。",
        "说“去追球”，让他跑过去。",
        "他拿到后招手说“拿回来”。",
        "回来击掌，再滚一次。"
      ],
      "observe": [
        "走跑时能停住",
        "会弯腰捡球不摔倒",
        "愿意往返多次。"
      ],
      "up": "换成会弹的球。",
      "down": "只滚1米。",
      "safety": "地面平整无台阶，避开马路和停车场，不追滚向车道的球。",
      "question": "走路总摔正常吗？刚会走步态宽、易摔正常，清空硬物即可；18个月仍走不稳可在体检时提出。",
